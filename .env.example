# Contenedor PostgreSQL (docker-compose)
POSTGRES_USER=itaca
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=itaca

# Conexión del script de ingesta (usuario de solo lectura)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itaca
DB_USER=lectura_bigdata
DB_PASSWORD=tu_contrasenya_aqui

# Clave secreta para anonimizar el NIA (HMAC). Genera una con: openssl rand -hex 32
# No cambiarla entre ingestas: si cambia, cambian todos los NIA anonimizados.
NIA_SALT=pon_aqui_una_clave_larga_y_aleatoria
